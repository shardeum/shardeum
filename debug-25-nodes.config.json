{
  "server": {
    "p2p": {
      "baselineNodes": 25,
      "minNodes": 20,
      "maxNodes": 30,
      "forceBogonFilteringOn": true,
      "syncFloorEnabled": true,
      "syncingDesiredMinCount": 15,
      "activeRecoveryEnabled": true,
      "flexibleRotationDelta": 5,
      "formingNodesPerCycle": 12,
      "rotationData": {
        "rotationIntervalInMs": 60000,
        "gracePeriodInMs": 10000,
        "maxRotationFailures": 3
      }
    },
    "sharding": {
      "nodesPerConsensusGroup": 10
    },
    "features": {
      "tickets": {
        "updateTicketListTimeInMs": 300000
      }
    },
    "mode": "debug",
    "debug": {
      "startInFatalsLogMode": false,
      "startInErrorLogMode": true
    }
  }
}
